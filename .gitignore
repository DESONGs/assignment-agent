.env.local
.enc.local
.DS_Store
**/.obsidian/
__pycache__/
*.pyc
node_modules/
.build/
**/.build/

# Local runtime state and dependency/model caches. Keep the reviewed Pi project
# contract and meeting subagent definitions versioned; generated Pi state stays
# ignored.
.pi/
!.pi/
.pi/*
!.pi/SYSTEM.md
!.pi/settings.json
!.pi/agents/
.pi/agents/*
!.pi/agents/meeting-*.md
.pi/agent-memory/
.pi-subagents/
.hf-cache/
.hf-home/
.uv-cache/
.uv-python/
.venv*/
models/
runtime-runs/

# Generated QA artifacts can contain raw transcript, model response, Feishu
# stdout/stderr, or local evidence payloads. Keep only README/marker docs in
# reviewable history.
qa-runs/
qa-runs/**/*.json
qa-runs/**/*.jsonl
qa-runs/**/*.txt
qa-runs/**/*.wav
qa-runs/**/*.mp3
qa-runs/**/*.m4a
qa-runs/**/*.mp4
qa-runs/**/__pycache__/
qa-runs/**/semantic/internal-model-artifacts/*.md
qa-runs/**/semantic-clean/*.response.json
!qa-runs/**/README.md
!qa-runs/**/*.marker
!qa-runs/**/.non-production
