{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "include": [
    "tests/*.test.mjs"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "runtime-runs"
  ]
}
