{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "scripts/*.mjs"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "runtime-runs"
  ]
}
