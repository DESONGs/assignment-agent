{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meeting-agent.local/schemas/office-task-state.schema.json",
  "title": "Office Task State Projection",
  "type": "object",
  "required": ["schemaVersion", "objective", "operation", "requestedDocuments", "completedWorkUnits", "openQuestions", "rawSecretsReturned"],
  "properties": {
    "schemaVersion": { "const": "office-task-state-v2" },
    "planId": { "type": ["string", "null"] },
    "planRevision": { "type": ["integer", "null"] },
    "objective": { "type": "string" },
    "operation": { "type": "string" },
    "requestedDocuments": { "type": "array", "items": { "type": "string" } },
    "sourceCount": { "type": "integer", "minimum": 0 },
    "segmentCount": { "type": "integer", "minimum": 0 },
    "meetingState": { "type": ["object", "null"] },
    "phase": { "enum": ["pending", "running", "completed", "blocked", "needs_fix", "failed"] },
    "completedDocuments": { "type": "array", "items": { "type": "string" } },
    "pendingDocuments": { "type": "array", "items": { "type": "string" } },
    "completedWorkUnits": { "type": "array", "items": { "type": "object" } },
    "openQuestions": { "type": "array", "items": { "type": "string" } },
    "updatedAt": { "type": "string" },
    "rawMediaExternalUpload": { "type": "boolean" },
    "rawSecretsReturned": { "const": false }
  },
  "additionalProperties": true
}
