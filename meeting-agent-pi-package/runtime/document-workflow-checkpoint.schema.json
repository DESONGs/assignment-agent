                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "reason": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "retryCount": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "attempts": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "retryExhausted": {
                      "type": "boolean"
                    },
                    "retryBudgetExhausted": {
                      "type": "boolean"
                    },
                    "lastProviderAttempt": {
                      "anyOf": [
                        {
                          "type": "object",
                          "patternProperties": {
                            "^.*$": {}
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "updatedAt": {
                      "type": "string",
                      "minLength": 1
