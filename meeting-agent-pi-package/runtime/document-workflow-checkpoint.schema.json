{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "inputHash",
    "createdAt",
    "updatedAt",
    "workflowStrategy",
    "qualityMode",
    "publishPartial",
    "retry",
    "docs",
    "rawSecretsReturned"
