  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "document-workflow-checkpoint-v2"
    },
    "runId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "inputHash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "createdAt": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1
    },
    "workflowStrategy": {
      "enum": [
        "checkpointed",
        "single_pass"
      ]
    },
    "qualityMode": {
      "enum": [
        "stable",
        "balanced",
        "fast"
      ]
    },
    "publishPartial": {
      "type": "boolean",
      "const": false
    },
    "retry": {
      "type": "object",
      "required": [
        "unitsUsed"
      ],
      "properties": {
        "unitsUsed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
