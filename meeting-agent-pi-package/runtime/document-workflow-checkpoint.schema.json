                        {
                          "type": "integer",
                          "minimum": 0
                        },
                        {
                          "type": "string",
                          "const": "full"
                        }
                      ]
                    },
                    "repairIndex": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "repairRound": {
                      "type": "integer",
                      "minimum": 0
