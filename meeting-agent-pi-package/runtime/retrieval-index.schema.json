{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "version",
    "indexId",
    "generatedAt",
    "channel",
    "context",
    "sourceRun",
    "pointerOnly",
    "entries",
    "rawSecretsReturned",
    "rawMediaExternalUpload"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "retrieval-index-v1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "indexId": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "enum": [
        "feishu",
        "wechat",
        "local"
      ]
    },
    "context": {
      "type": "object",
      "required": [
        "contextId",
        "actor",
        "conversation",
        "workspace",
        "permissions"
      ],
      "properties": {
        "contextId": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "object",
          "patternProperties": {
            "^.*$": {}
          }
        },
        "conversation": {
          "type": "object",
          "patternProperties": {
            "^.*$": {}
          }
        },
        "workspace": {
          "type": "object",
          "patternProperties": {
            "^.*$": {}
          }
        },
        "replyTarget": {},
        "permissions": {
          "type": "object",
          "patternProperties": {
            "^.*$": {}
          }
        }
      },
      "additionalProperties": true
    },
    "sourceRun": {
      "type": "object",
      "required": [
        "runId",
        "version",
        "artifactPointer"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "artifactPointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "pointerOnly": {
      "type": "boolean",
      "const": true
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entryId",
          "objectType",
          "channel",
          "context",
          "sourceRun",
          "version",
          "title",
          "summary",
          "boundedPreview",
          "tags",
          "pointers",
          "pointerOnly"
        ],
        "properties": {
          "entryId": {
            "type": "string",
            "minLength": 1
          },
          "objectType": {
            "enum": [
              "document",
              "file",
              "meeting",
              "transcript_summary",
              "task",
              "calendar_event",
              "contact",
              "project",
              "customer",
              "preference",
              "run"
            ]
          },
          "channel": {
            "enum": [
              "feishu",
              "wechat",
              "local"
            ]
          },
          "context": {
            "type": "object",
            "required": [
              "contextId",
              "actor",
              "conversation",
              "workspace",
              "permissions"
            ],
            "properties": {
              "contextId": {
                "type": "string",
                "minLength": 1
              },
              "actor": {
                "type": "object",
                "patternProperties": {
                  "^.*$": {}
                }
              },
              "conversation": {
                "type": "object",
                "patternProperties": {
                  "^.*$": {}
                }
              },
              "workspace": {
                "type": "object",
                "patternProperties": {
                  "^.*$": {}
                }
              },
              "replyTarget": {},
              "permissions": {
                "type": "object",
                "patternProperties": {
                  "^.*$": {}
                }
              }
            },
            "additionalProperties": true
          },
          "sourceRun": {
            "type": "object",
            "required": [
              "runId",
              "version",
              "artifactPointer"
            ],
            "properties": {
              "runId": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "artifactPointer": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "boundedPreview": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pointers": {
            "type": "object",
            "required": [
              "artifactPointer",
              "summaryPointer",
              "metadataPointer",
              "embeddingPointer"
            ],
            "properties": {
              "artifactPointer": {
                "type": "string",
                "minLength": 1
              },
              "summaryPointer": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "metadataPointer": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "embeddingPointer": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "pointerOnly": {
            "type": "boolean",
            "const": true
          }
        },
        "additionalProperties": false
      }
    },
    "rawSecretsReturned": {
      "type": "boolean",
      "const": false
    },
    "rawMediaExternalUpload": {
      "type": "boolean",
      "const": false
    }
  },
  "$id": "https://meeting-agent.local/schemas/retrieval-index.schema.json",
  "title": "Retrieval Index",
  "additionalProperties": false
}
