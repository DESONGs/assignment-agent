{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "version",
    "documentId",
    "channel",
    "context",
    "sourceRun",
    "currentState",
    "target",
    "lifecycleEvents",
    "destructiveActionsAllowed",
    "rawSecretsReturned",
    "rawMediaExternalUpload"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "document-lifecycle-v1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "documentId": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "enum": [
        "feishu",
        "wechat",
        "local"
      ]
    },
    "context": {
      "type": "object",
      "required": [
        "contextId",
        "actor",
        "conversation",
        "workspace",
        "permissions"
      ],
      "properties": {
        "contextId": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "object",
          "patternProperties": {
            "^.*$": {}
          }
        },
        "conversation": {
          "type": "object",
          "patternProperties": {
            "^.*$": {}
          }
        },
        "workspace": {
          "type": "object",
          "patternProperties": {
            "^.*$": {}
          }
        },
        "replyTarget": {},
        "permissions": {
          "type": "object",
          "patternProperties": {
            "^.*$": {}
          }
        }
      },
      "additionalProperties": true
    },
    "sourceRun": {
      "type": "object",
      "required": [
        "runId",
        "version",
        "artifactPointer"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "artifactPointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "currentState": {
      "enum": [
        "draft",
        "review",
        "published",
        "revision_requested",
        "blocked",
        "archived"
      ]
    },
    "target": {
      "type": "object",
      "patternProperties": {
        "^.*$": {}
      }
    },
    "lifecycleEvents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "eventId",
          "action",
          "sourceRun",
          "version",
          "artifactPointer",
          "diffPointer",
          "summaryPointer",
          "requiresConfirmation",
          "confirmationStatus"
        ],
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "created",
              "revised",
              "section_rewritten",
              "diff_generated",
              "comment_added",
              "template_applied",
              "merged",
              "published",
              "blocked"
            ]
          },
          "sourceRun": {
            "type": "object",
            "required": [
              "runId",
              "version",
              "artifactPointer"
            ],
            "properties": {
              "runId": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "artifactPointer": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "artifactPointer": {
            "type": "string",
            "minLength": 1
          },
          "diffPointer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "summaryPointer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "requiresConfirmation": {
            "type": "boolean"
          },
          "confirmationStatus": {
            "enum": [
              "not_required",
              "pending",
              "confirmed",
              "denied"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "destructiveActionsAllowed": {
      "type": "boolean",
      "const": false
    },
    "rawSecretsReturned": {
      "type": "boolean",
      "const": false
    },
    "rawMediaExternalUpload": {
      "type": "boolean",
      "const": false
    }
  },
  "$id": "https://meeting-agent.local/schemas/document-lifecycle.schema.json",
  "title": "Document Lifecycle",
  "additionalProperties": false
}
