{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meeting-agent.local/schemas/office-object.schema.json",
  "title": "Office Object",
  "type": "object",
  "required": ["schemaVersion", "version", "objectId", "objectType", "channel", "context", "sourceRun", "pointers", "rawSecretsReturned"],
  "properties": {
    "schemaVersion": { "const": "office-object-v1" },
    "version": { "type": "string", "minLength": 1 },
    "objectId": { "type": "string", "minLength": 1 },
    "objectType": {
      "enum": ["document", "file", "meeting", "transcript_summary", "task", "calendar_event", "contact", "project", "customer", "preference", "run"]
    },
    "title": { "type": ["string", "null"] },
    "channel": { "enum": ["feishu", "wechat", "local"] },
    "context": { "$ref": "office-context.schema.json#/properties/context" },
    "sourceRun": { "$ref": "office-context.schema.json#/properties/sourceRun" },
    "visibility": { "enum": ["private", "conversation", "workspace", "customer_visible"] },
    "pointers": {
      "type": "object",
      "properties": {
        "artifactPointer": { "type": ["string", "null"] },
        "summaryPointer": { "type": ["string", "null"] },
        "metadataPointer": { "type": ["string", "null"] },
        "sourcePointer": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "rawSecretsReturned": { "const": false },
    "rawMediaExternalUpload": { "const": false }
  },
  "additionalProperties": true
}
