{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meeting-agent.local/schemas/qa-gate.schema.json",
  "title": "Meeting Agent QA Gate",
  "type": "object",
  "required": ["status", "issues", "checks"],
  "properties": {
    "status": { "enum": ["pass", "needs_fix", "blocked"] },
    "primaryDeliveryStatus": { "enum": ["ready", "needs_fix", "blocked"] },
    "followUpDeliveryStatus": { "enum": ["pass", "needs_fix", "blocked", "not_applicable"] },
    "overallStatus": { "enum": ["ready", "partial_ready", "blocked"] },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string" },
          "type": { "type": "string" },
          "severity": { "enum": ["info", "warning", "needs_fix", "blocking"] },
          "message": { "type": "string" },
          "evidence": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "oneOf": [
                    { "type": "string" },
                    { "type": "object", "additionalProperties": true }
                  ]
                }
              },
              { "type": "object", "additionalProperties": true },
              { "type": "string" }
            ]
          },
          "fix": { "type": "string" },
          "suggestedFix": { "type": "string" },
          "artifactType": { "type": "string" },
          "priority": { "enum": ["primary", "follow_up", "optional"] },
          "blocksDelivery": { "type": "boolean" }
        }
      }
    },
    "checks": {
      "type": "object",
      "properties": {
        "privacy": { "type": "object" },
        "evidence": { "type": "object" },
        "topicCoverage": {
          "type": "object",
          "properties": {
            "omittedMacroTopics": {
              "type": "array",
              "items": {
                "oneOf": [
                  { "type": "string" },
                  {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                      "topic": { "type": "string" },
                      "topicId": { "type": "string" },
                      "timeRange": { "type": "string" },
                      "segmentRefs": { "type": "array", "items": { "type": "string" } },
                      "evidenceRefs": { "type": "array", "items": { "type": "string" } },
                      "reason": { "type": "string" }
                    }
                  }
                ]
              }
            }
          }
        },
        "entitySafety": {
          "type": "object",
          "properties": {
            "unsupportedEntities": {
              "type": "array",
              "items": {
                "oneOf": [
                  { "type": "string" },
                  { "type": "object", "additionalProperties": true }
                ]
              }
            },
            "crossMeetingTerms": {
              "type": "array",
              "items": {
                "oneOf": [
                  { "type": "string" },
                  { "type": "object", "additionalProperties": true }
                ]
              }
            },
            "ambiguousTermExpansions": {
              "type": "array",
              "items": {
                "oneOf": [
                  { "type": "string" },
                  { "type": "object", "additionalProperties": true }
                ]
              }
            }
          }
        },
        "titleSync": { "type": "object" },
        "feishuReadiness": { "type": "object" },
        "webAccess": { "type": "object" },
        "contextBudget": { "type": "object" },
        "documentOutputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "docType": { "type": "string" },
              "artifactType": { "type": "string" },
              "priority": { "enum": ["primary", "follow_up", "optional"] },
              "deliveryTier": { "enum": ["primary", "follow_up", "optional"] },
              "requiredSections": { "type": "array", "items": { "type": "string" } },
              "missingSections": { "type": "array", "items": { "type": "string" } },
              "dependsOn": { "type": "array", "items": { "type": "string" } },
              "audience": { "type": ["string", "null"] },
              "upstreamDocumentsUsed": { "type": "array", "items": { "type": "string" } },
              "missingUpstreamDocuments": { "type": "array", "items": { "type": "string" } },
              "absentUpstreamDocuments": { "type": "array", "items": { "type": "string" } },
              "unsupportedClaims": { "type": "array" },
              "openQuestions": { "type": "array" },
              "routerReasonCovered": { "type": "boolean" },
              "crossDocumentContamination": { "type": "array" }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifactType", "priority", "status", "blocksDelivery"],
        "additionalProperties": true,
        "properties": {
          "artifactType": { "type": "string" },
          "docType": { "type": "string" },
          "priority": { "enum": ["primary", "follow_up", "optional"] },
          "status": { "enum": ["pass", "needs_fix", "blocked"] },
          "blocksDelivery": { "type": "boolean" },
          "issueCodes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "publishAllowed": { "type": "boolean" },
    "evaluatedAt": { "type": "string" }
  }
}
