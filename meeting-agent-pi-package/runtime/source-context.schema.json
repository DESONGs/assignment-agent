{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "contextPlane",
    "runId",
    "operation",
    "requestedDocuments",
    "sourceRecordsPath",
    "sourceSegmentsPath",
    "sourceStructurePath",
    "taskStatePath",
    "retrievalPlanPath",
    "gatePath",
    "sourceCount",
    "segmentCount",
    "sourceStructureSummary",
    "documentIdentity",
    "meetingIntelligence",
    "outputContract",
    "workUnitCount",
    "contextPackCount",
    "artifactHashes",
    "sourceSetMode",
    "conflictPolicy",
    "budgetPolicy",
    "workUnits",
    "gate",
    "rawSecretsReturned",
    "rawMediaExternalUpload",
    "fullContentAvailableByArtifact"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "source-context-v3/context-manifest"
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "contextPlane": {
      "type": "string",
      "const": "runtime-context-plane-v1"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "requestedDocuments": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceRecordsPath": {
      "type": "string",
      "minLength": 1
    },
    "sourceSegmentsPath": {
      "type": "string",
      "minLength": 1
    },
    "sourceStructurePath": {
      "type": "string",
      "minLength": 1
    },
    "taskStatePath": {
      "type": "string",
      "minLength": 1
    },
    "retrievalPlanPath": {
      "type": "string",
      "minLength": 1
    },
    "gatePath": {
      "type": "string",
      "minLength": 1
    },
    "sourceCount": {
      "type": "integer",
      "minimum": 0
    },
    "segmentCount": {
      "type": "integer",
      "minimum": 0
    },
    "sourceStructureSummary": {
      "type": "object",
      "required": [
        "blockCount",
        "headingCount",
        "tableBlockCount",
        "rawHtmlTableCount",
        "markdownTableCount",
        "commentAnchorCount"
      ],
      "properties": {
        "blockCount": {
          "type": "integer",
          "minimum": 0
        },
        "headingCount": {
          "type": "integer",
          "minimum": 0
        },
        "tableBlockCount": {
          "type": "integer",
          "minimum": 0
        },
        "rawHtmlTableCount": {
          "type": "integer",
          "minimum": 0
        },
        "markdownTableCount": {
          "type": "integer",
          "minimum": 0
        },
        "commentAnchorCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "documentIdentity": {
      "type": "object",
      "patternProperties": {
        "^.*$": {}
      }
    },
    "meetingIntelligence": {
      "anyOf": [
        {
          "type": "object",
          "patternProperties": {
            "^.*$": {}
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "outputContract": {
      "type": "object",
      "patternProperties": {
        "^.*$": {}
      }
    },
    "workUnitCount": {
      "type": "integer",
      "minimum": 0
    },
    "contextPackCount": {
      "type": "integer",
      "minimum": 0
    },
    "artifactHashes": {
      "type": "object",
      "required": [
        "sourceRecords",
        "sourceSegments",
        "sourceStructure",
        "retrievalPlan",
        "gate"
      ],
      "properties": {
        "sourceRecords": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceSegments": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceStructure": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "retrievalPlan": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "gate": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "sourceSetMode": {
      "type": "string",
      "minLength": 1
    },
    "conflictPolicy": {
      "type": "string",
      "minLength": 1
    },
    "budgetPolicy": {
      "type": "object",
      "required": [
        "sectionPromptHardCapChars",
        "evidenceHardCapChars",
        "segmentTargetChars",
        "segmentMaxChars",
        "deterministicRetrieval",
        "vectorStoreUsed",
        "contextStrategy",
        "repeatedFullTranscriptInjection"
      ],
      "properties": {
        "sectionPromptHardCapChars": {
          "type": "integer",
          "minimum": 1
        },
        "evidenceHardCapChars": {
          "type": "integer",
          "minimum": 1
        },
        "segmentTargetChars": {
          "type": "integer",
          "minimum": 1
        },
        "segmentMaxChars": {
          "type": "integer",
          "minimum": 1
        },
        "deterministicRetrieval": {
          "type": "boolean",
          "const": true
        },
        "vectorStoreUsed": {
          "type": "boolean",
          "const": false
        },
        "contextStrategy": {
          "type": "string",
          "const": "hierarchical_control_plane_and_work_unit_data_plane"
        },
        "repeatedFullTranscriptInjection": {
          "type": "boolean",
          "const": false
        }
      },
      "additionalProperties": false
    },
    "workUnits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "workUnitId",
          "docType",
          "sections",
          "contextPackRef",
          "contextPackId",
          "contextPackHash",
          "sourceSegmentIds",
          "sourceBlockIds",
          "tableBlockCount",
          "promptBudgetChars",
          "evidenceBudgetChars",
          "retrievalReasons",
          "outputContractVersion",
          "documentIdentityConfidence",
          "taskStateRef",
          "sourceRecordsRef",
          "sourceSegmentsRef",
          "sourceStructureRef"
        ],
        "properties": {
          "workUnitId": {
            "type": "string",
            "minLength": 1
          },
          "docType": {
            "type": "string",
            "minLength": 1
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "contextPackRef": {
            "type": "string",
            "minLength": 1
          },
          "contextPackId": {
            "type": "string",
            "minLength": 1
          },
          "contextPackHash": {
            "type": "string",
            "minLength": 1
          },
          "sourceSegmentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sourceBlockIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tableBlockCount": {
            "type": "integer",
            "minimum": 0
          },
          "promptBudgetChars": {
            "type": "integer",
            "minimum": 1,
            "maximum": 24000
          },
          "evidenceBudgetChars": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12000
          },
          "retrievalReasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputContractVersion": {
            "type": "string",
            "const": "document-output-contract-v1"
          },
          "documentIdentityConfidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "taskStateRef": {
            "type": "string",
            "minLength": 1
          },
          "sourceRecordsRef": {
            "type": "string",
            "minLength": 1
          },
          "sourceSegmentsRef": {
            "type": "string",
            "minLength": 1
          },
          "sourceStructureRef": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "gate": {
      "type": "object",
      "required": [
        "schemaVersion",
        "status",
        "reason",
        "warnings",
        "missingOrStaleInputs",
        "rawSecretsReturned",
        "rawMediaExternalUpload"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "context-gate-result-v1"
        },
        "status": {
          "enum": [
            "pass",
            "needs_fix",
            "blocked"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missingOrStaleInputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fieldPath": {
          "type": "string"
        },
        "recovery": {
          "type": "string"
        },
        "rawSecretsReturned": {
          "type": "boolean",
          "const": false
        },
        "rawMediaExternalUpload": {
          "type": "boolean",
          "const": false
        }
      },
      "additionalProperties": false
    },
    "rawSecretsReturned": {
      "type": "boolean",
      "const": false
    },
    "rawMediaExternalUpload": {
      "type": "boolean",
      "const": false
    },
    "fullContentAvailableByArtifact": {
      "type": "boolean",
      "const": true
    }
  },
  "$id": "https://meeting-agent.local/schemas/source-context.schema.json",
  "title": "Runtime Source Context Plane",
  "additionalProperties": false
}
