{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meeting-agent.local/schemas/office-context.schema.json",
  "title": "Office Context",
  "type": "object",
  "required": ["schemaVersion", "version", "channel", "context", "sourceRun", "rawSecretsReturned"],
  "properties": {
    "schemaVersion": { "const": "office-context-v1" },
    "version": { "type": "string", "minLength": 1 },
    "channel": { "enum": ["feishu", "wechat", "local"] },
    "context": {
      "type": "object",
      "required": ["contextId", "actor", "conversation", "workspace"],
      "properties": {
        "contextId": { "type": "string", "minLength": 1 },
        "actor": { "type": "object", "additionalProperties": true },
        "conversation": { "type": "object", "additionalProperties": true },
        "workspace": { "type": "object", "additionalProperties": true },
        "replyTarget": { "type": ["object", "null"], "additionalProperties": true },
        "permissions": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "sourceRun": {
      "type": "object",
      "required": ["runId", "version"],
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "artifactPointer": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "rawSecretsReturned": { "const": false }
  },
  "additionalProperties": true
}
