{
  "$schema": "execution-profiles.schema.json",
  "version": "execution-profiles-v1",
  "profiles": {
    "fast_answer": {
      "runnerEligible": true,
      "pipeline": "fast_answer",
      "routeTaskType": "fast_draft",
      "reasoningDepth": "fast",
      "requiredStages": ["model_route", "model_generate_text", "reply"],
      "skipStages": ["planner_envelope", "document_workers", "qa_gate", "policy_gate", "publish", "local_asr"],
      "publishDocuments": false,
      "qaGate": false,
      "policyGate": false,
      "documentWorkers": false,
      "localAsr": "never",
      "rawMediaExternalUpload": false
    },
    "file_summary": {
      "runnerEligible": true,
      "pipeline": "file_summary",
      "routeTaskType": "fast_draft",
      "reasoningDepth": "fast",
      "requiredStages": ["file_context", "model_route", "model_generate_text", "reply"],
      "skipStages": ["planner_envelope", "document_workers", "qa_gate", "policy_gate", "publish", "local_asr"],
      "publishDocuments": false,
      "qaGate": false,
      "policyGate": false,
      "documentWorkers": false,
      "localAsr": "never",
      "rawMediaExternalUpload": false,
      "contextPolicy": {
        "maxSources": 6,
        "previewCharsPerSource": 4000,
        "extractedSliceChars": 5000,
        "maxExtractedSlicesPerSource": 2,
        "maxPromptChars": 30000
      }
    },
    "audio_minutes": {
      "runnerEligible": true,
      "pipeline": "full_document",
      "routeTaskType": "meeting_minutes",
