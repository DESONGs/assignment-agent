      "skipStages": ["direct_answer"],
      "publishDocuments": true,
      "qaGate": true,
      "policyGate": true,
      "documentWorkers": true,
      "localAsr": "when_required",
      "asrProvider": "auto",
      "rawMediaExternalUpload": true
    },
    "document_generation": {
      "runnerEligible": true,
      "pipeline": "full_document",
      "routeTaskType": "document_shard",
      "reasoningDepth": "deep",
      "requiredStages": ["evidence_pack", "prompt_registry", "document_workers", "qa_gate", "policy_gate", "publish"],
      "skipStages": ["local_asr_unless_required", "direct_answer"],
      "publishDocuments": true,
      "qaGate": true,
      "policyGate": true,
      "documentWorkers": true,
      "localAsr": "when_required",
      "rawMediaExternalUpload": false
    },
    "document_revision": {
      "runnerEligible": true,
      "pipeline": "full_document",
      "routeTaskType": "document_shard",
      "reasoningDepth": "deep",
      "operation": "document_revision",
      "requiredStages": ["file_context", "review_context", "evidence_pack", "prompt_registry", "document_workers", "qa_gate", "policy_gate", "publish"],
      "skipStages": ["local_asr_unless_required", "direct_answer"],
      "publishDocuments": true,
      "qaGate": true,
      "policyGate": true,
      "documentWorkers": true,
      "localAsr": "when_required",
      "rawMediaExternalUpload": false
    },
    "multi_source_synthesis": {
      "runnerEligible": true,
      "pipeline": "full_document",
      "routeTaskType": "document_shard",
      "reasoningDepth": "deep",
      "requiredStages": ["source_map", "evidence_pack", "prompt_registry", "document_workers", "qa_gate", "policy_gate", "publish"],
      "skipStages": ["local_asr_unless_required", "direct_answer"],
      "publishDocuments": true,
      "qaGate": true,
      "policyGate": true,
      "documentWorkers": true,
      "localAsr": "when_required",
      "rawMediaExternalUpload": false
    },
    "publish_only": {
      "runnerEligible": false,
      "pipeline": "immediate",
      "requiredStages": ["policy_gate", "publish"],
      "skipStages": ["model_route", "model_generate_text", "document_workers", "qa_gate", "local_asr"],
      "publishDocuments": true,
      "qaGate": false,
      "policyGate": false,
      "documentWorkers": false,
      "localAsr": "never",
      "rawMediaExternalUpload": false
    },
    "unsupported": {
      "runnerEligible": false,
      "pipeline": "immediate",
      "requiredStages": ["immediate_response", "reply"],
      "skipStages": ["model_route", "model_generate_text", "document_workers", "qa_gate", "policy_gate", "publish", "local_asr"],
      "publishDocuments": false,
      "qaGate": false,
      "policyGate": false,
      "documentWorkers": false,
      "localAsr": "never",
      "rawMediaExternalUpload": false
    }
