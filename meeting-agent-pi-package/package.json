{
  "name": "meeting-agent-pi-package",
  "version": "0.2.0",
  "description": "Pi Office Agent package with typed task contracts, meeting intelligence, evidence-grounded documents, Feishu workflows, and public URL source packs.",
  "keywords": [
    "pi-package",
    "meeting-agent",
    "subagents",
    "dynamic-workflows",
    "feishu",
    "rokid",
    "persistent-memory"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/task-contracts.d.ts",
      "import": "./dist/contracts/task-contracts.js",
      "default": "./dist/contracts/task-contracts.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "extensions/*.ts",
    "prompts/*.md",
    "runtime/*.json",
    "runtime/package-audits/*.json",
    "skills/**/SKILL.md",
    "tools/*.mjs",
    "tools/*.py",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/write-runtime-contract-manifest.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck:extensions && npm run typecheck:runtime-js && npm run typecheck:tests-js && npm run typecheck:scripts-js",
    "typecheck:extensions": "tsc -p tsconfig.extensions.json",
    "typecheck:agentic": "npm run typecheck:extensions",
    "typecheck:runtime-js": "tsc -p tsconfig.runtime-js.json",
    "typecheck:tests-js": "tsc -p tsconfig.tests-js.json",
    "typecheck:scripts-js": "tsc -p tsconfig.scripts-js.json",
    "contracts:check": "node scripts/check-runtime-contracts.mjs",
    "package:check": "node scripts/package-invariants.mjs",
    "pretest": "npm run build && npm run contracts:check",
    "test": "node --test tests/*.test.mjs && npm run typecheck",
    "publint": "node scripts/run-publint.mjs",
    "pack:dry-run": "node scripts/pack-dry-run.mjs",
    "pack:smoke": "node scripts/release-local.mjs",
    "prepack": "npm run build && npm run contracts:check && npm run package:check",
    "release:local": "npm run publint && npm run pack:smoke"
  },
  "pi": {
    "extensions": [
      "./extensions",
      "./node_modules/pi-subagents/index.ts",
      "./node_modules/@quintinshaw/pi-dynamic-workflows/extensions/workflow.ts"
    ],
    "skills": [
      "./skills",
      "./node_modules/pi-subagents/skills",
      "./node_modules/@quintinshaw/pi-dynamic-workflows/skills/workflow-authoring",
      "./node_modules/@quintinshaw/pi-dynamic-workflows/skills/workflow-patterns"
    ],
    "prompts": [
      "./prompts",
      "./node_modules/pi-subagents/prompts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.84.1 <0.85.0",
    "@earendil-works/pi-ai": ">=0.84.1 <0.85.0",
    "@earendil-works/pi-coding-agent": ">=0.84.1 <0.85.0",
    "@earendil-works/pi-tui": ">=0.84.1 <0.85.0",
    "@larksuiteoapi/node-sdk": ">=1.73.0 <2.0.0",
    "@quintinshaw/pi-dynamic-workflows": ">=3.5.1 <3.6.0",
    "pi-subagents": ">=0.46.0 <0.47.0",
    "typebox": ">=1.3.7 <2.0.0"
  },
  "peerDependenciesMeta": {
    "@larksuiteoapi/node-sdk": {
      "optional": true
    }
  },
  "dependencies": {
    "fast-xml-parser": "5.7.3",
    "protobufjs": "7.6.5",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@larksuiteoapi/node-sdk": "1.73.0",
    "@quintinshaw/pi-dynamic-workflows": "3.5.1",
    "@types/node": "24.12.4",
    "pi-subagents": "0.46.0",
    "publint": "0.3.23",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  },
  "overrides": {
    "protobufjs": "7.6.5"
  }
}
