# Meeting Agent local runtime config
# Copy to .env.local and fill real API keys. Never commit .env.local.

# Default orchestration/document LLM: DeepSeek V4
PI_PROVIDER=deepseek
PI_MODEL=deepseek-v4-pro

# Reviewer/fallback LLM: Xiaomi MiMo Token Plan SGP
PI_REVIEW_PROVIDER=xiaomi-token-plan-sgp
PI_REVIEW_MODEL=mimo-v2.5-pro

# Local ASR fallback service.
LOCAL_ASR_SERVICE_URL=http://127.0.0.1:8765
LOCAL_ASR_MODEL_DIR=models/Qwen3-ASR-1.7B-MLX-4bit

# Privacy defaults for meeting semantics.
# Raw media may only leave the machine during the explicitly requested cloud ASR stage.
MEETING_TEXT_EVIDENCE_EXTERNAL_LLM_DEFAULT=allow
MEETING_RAW_MEDIA_EXTERNAL_UPLOAD_DEFAULT=allow_for_cloud_asr

# Cloud-first ASR. File recordings use OSS + Paraformer file transcription when
# OSS credentials are configured; realtime-compatible inputs otherwise stream
# directly, and remaining cloud-supported containers are normalized then retried.
MEETING_ASR_PROVIDER=auto
MEETING_ASR_FALLBACK_PROVIDER=local_qwen3
ALIYUN_DASHSCOPE_API_KEY=
ALIYUN_ASR_INPUT_MODE=auto
ALIYUN_ASR_MODEL=paraformer-realtime-v2
ALIYUN_ASR_FILE_MODEL=paraformer-v2
ALIYUN_ASR_ENDPOINT=wss://dashscope.aliyuncs.com/api-ws/v1/inference
ALIYUN_ASR_FILE_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/audio/asr/transcription
ALIYUN_ASR_LANGUAGE_HINTS=yue,zh,en
# Recorded-file only: auto enables anonymous speaker diarization when the
# runtime can supply mono audio. Realtime Paraformer does not use these fields.
ALIYUN_ASR_DIARIZATION_ENABLED=auto
# Optional provider hint, integer 2..100. Leave empty when unknown.
ALIYUN_ASR_SPEAKER_COUNT=
ALIYUN_ASR_TIMESTAMP_ALIGNMENT_ENABLED=true

# Xiaomi MiMo Token Plan SGP
# OpenAI-compatible endpoint shown by Xiaomi:
# https://token-plan-sgp.xiaomimimo.com/v1
XIAOMI_TOKEN_PLAN_SGP_API_KEY=

# DeepSeek V4
# Official OpenAI-compatible endpoint:
# https://api.deepseek.com
DEEPSEEK_API_KEY=

# Feishu uses official lark-cli login state.
# Do not put Feishu tokens here.
LARK_CLI_PROFILE=default

# Hermes sidecar must not receive Feishu/Rokid credentials.
HERMES_SIDECAR_NO_EXTERNAL_TOKENS=1

# Aliyun OSS (keep real credentials in .env.local only)
ALIYUN_OSS_BUCKET=meetingagent-feishu
ALIYUN_OSS_REGION=oss-cn-beijing
ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_BUCKET_ENDPOINT=https://meetingagent-feishu.oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_ASR_PREFIX=agent-asr
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_OSS_SIGNED_URL_TTL_SECONDS=86400
